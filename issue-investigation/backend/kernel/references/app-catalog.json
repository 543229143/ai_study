{
  "description": "应用元数据 + 跨服务排查链路。primary_schema 为 SQL 中 {{schema}} 默认值。DB 查询仅从 Mapper XML 自动生成，不使用固定 SQL 模板。",
  "biz_key_patterns": {
    "_global": [
      {"pattern": "(?:loan[_ ]?no|loanNo|借据)[:：=\\s\"]+\\s*\"?([A-Za-z0-9_-]+)", "kind": "loan_no", "log_field": "loanNo"},
      {"pattern": "\"loanNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "loan_no", "log_field": "loanNo"},
      {"pattern": "\"loan_no\"\\s*:\\s*\"([^\"]+)\"", "kind": "loan_no", "log_field": "loan_no"},
      {"pattern": "\\b(LN[a-f0-9]{10,})\\b", "kind": "loan_no", "log_field": ""},
      {"pattern": "\\b(L\\d{10,})\\b", "kind": "loan_no", "log_field": ""},
      {"pattern": "\"orderNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "order_no", "log_field": "orderNo"},
      {"pattern": "\"order_no\"\\s*:\\s*\"([^\"]+)\"", "kind": "order_no", "log_field": "order_no"},
      {"pattern": "(?:order[_ ]?no|orderNo|订单)[:：=\\s\"]+\\s*\"?([A-Za-z0-9_-]+)", "kind": "order_no", "log_field": "orderNo"},
      {"pattern": "\\b(O\\d{10,})\\b", "kind": "order_no", "log_field": ""}
    ],
    "lps": [
      {"pattern": "\"applNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "appl_no", "log_field": "applNo"},
      {"pattern": "\"appl_no\"\\s*:\\s*\"([^\"]+)\"", "kind": "appl_no", "log_field": "appl_no"},
      {"pattern": "(?:appl[_ ]?no|applNo)[:：=\\s\"]+\\s*\"?([A-Za-z0-9_-]+)", "kind": "appl_no", "log_field": "applNo"}
    ],
    "ams": [
      {"pattern": "\"applyNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "apply_no", "log_field": "applyNo"},
      {"pattern": "\"apply_no\"\\s*:\\s*\"([^\"]+)\"", "kind": "apply_no", "log_field": "apply_no"},
      {"pattern": "(?:apply[_ ]?no|applyNo)[:：=\\s\"]+\\s*\"?([A-Za-z0-9_-]+)", "kind": "apply_no", "log_field": "applyNo"},
      {"pattern": "\\b(CR\\d{10,})\\b", "kind": "apply_no", "log_field": ""},
      {"pattern": "\"acctNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "acct_no", "log_field": "acctNo"},
      {"pattern": "\"acct_no\"\\s*:\\s*\"([^\"]+)\"", "kind": "acct_no", "log_field": "acct_no"},
      {"pattern": "(?:acct[_ ]?no|acctNo)[:：=\\s\"]+\\s*\"?([A-Za-z0-9_*]+)", "kind": "acct_no", "log_field": "acctNo"},
      {"pattern": "\"custNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "cust_no", "log_field": "custNo"},
      {"pattern": "\"cust_no\"\\s*:\\s*\"([^\"]+)\"", "kind": "cust_no", "log_field": "cust_no"}
    ],
    "lcs": [
      {"pattern": "\"privilege[_ ]?plan[_ ]?no\"\\s*:\\s*\"([^\"]+)\"", "kind": "privilege_plan_no", "log_field": "privilegePlanNo"},
      {"pattern": "(?:privilege[_ ]?plan[_ ]?no|privilegePlanNo)[:：=\\s\"]+\\s*\"?([A-Za-z0-9_-]+)", "kind": "privilege_plan_no", "log_field": "privilegePlanNo"}
    ],
    "goa": [
      {"pattern": "\"fundPrivilegeOrderNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "fund_order_no", "log_field": "fundPrivilegeOrderNo"},
      {"pattern": "\"fundOrderNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "fund_order_no", "log_field": "fundOrderNo"},
      {"pattern": "\"fundTranReqNo\"\\s*:\\s*\"([^\"]+)\"", "kind": "fund_tran_req_no", "log_field": "fundTranReqNo"}
    ]
  },
  "environments": {
    "dev": { "supported": true },
    "sit": { "supported": true },
    "prod": { "supported": false, "note": "生产独立方案，本技能暂不介入" }
  },
  "cross_service_flows": {
    "credit-apply": {
      "description": "授信全流程（申请→机构→账务）",
      "apps": ["lps", "goa", "lcs", "ams"],
      "scenarios": {
        "lps": "credit-apply",
        "goa": "callback",
        "lcs": "default",
        "ams": "default"
      }
    },
    "callback": {
      "description": "机构回调链路",
      "apps": ["goa", "lps"],
      "scenarios": {
        "goa": "callback",
        "lps": "credit-apply"
      }
    },
    "repay": {
      "description": "还款/计划链路",
      "apps": ["lcs", "goa", "ams"],
      "scenarios": {
        "lcs": "repay",
        "goa": "default",
        "ams": "default"
      }
    },
    "disburse": {
      "description": "放款链路",
      "apps": ["lps", "lcs", "goa"],
      "scenarios": {
        "lps": "default",
        "lcs": "default",
        "goa": "default"
      }
    }
  },
  "apps": {
    "goa": {
      "container": "goa-service",
      "primary_schema": "goa",
      "nacos_group": "goa-service",
      "nacos_data_ids": ["application.properties", "osi.properties"],
      "scenarios": {
        "default": { "description": "通用排查" },
        "callback": { "description": "机构回调" }
      }
    },
    "lcs": {
      "container": "lcs-service",
      "primary_schema": "lcs",
      "nacos_group": "lcs",
      "nacos_data_ids": ["application.properties"],
      "nacos_note": "优先从 LcsServiceApplication @NacosPropertySource 发现；以下为兜底",
      "scenarios": {
        "default": { "description": "通用排查" },
        "repay": { "description": "还款/计划" },
        "privilege-plan": { "description": "权益/特权还款计划" }
      }
    },
    "ams": {
      "container": "ams-service",
      "primary_schema": "ams",
      "nacos_group": "ams",
      "nacos_data_ids": ["application.properties"],
      "scenarios": {
        "default": { "description": "通用排查" }
      }
    },
    "lps": {
      "container": "lps-service",
      "primary_schema": "lps",
      "nacos_group": "lps-service",
      "nacos_data_ids": ["biz.properties", "application.properties"],
      "scenarios": {
        "default": { "description": "通用排查" },
        "credit-apply": { "description": "授信申请" }
      }
    }
  }
}
